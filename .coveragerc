[run]
branch = True
source =
    biomechanics
    expert_system
    persistence
    vision
    gui
omit =
    */__init__.py
    diagramas/*
    test_antijitter.py
    test_camaras.py

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
