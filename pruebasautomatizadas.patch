+
+import pytest
+
+ctk = pytest.importorskip("customtkinter", reason="CustomTkinter no está instalado")
+pytest.importorskip("cv2", reason="OpenCV no está instalado")
+pytest.importorskip("mediapipe", reason="MediaPipe no está instalado")
