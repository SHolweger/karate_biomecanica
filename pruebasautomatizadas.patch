+[pytest]
+# Solo se recolecta la carpeta tests/: los scripts de evidencia de la raíz
+# (test_antijitter.py, test_camaras.py) NO son pruebas automatizadas — abren
+# cámara o generan gráficas y no deben correr en CI.
